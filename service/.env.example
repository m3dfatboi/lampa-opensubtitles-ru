NODE_ENV=production
PORT=8090
PUBLIC_BASE_URL=https://YOUR_SERVER_OR_DOMAIN
DB_PATH=./data/lampa_translate.sqlite

# Telegram
TELEGRAM_BOT_TOKEN=123456:telegram-token
TELEGRAM_BOT_USERNAME=your_bot
TELEGRAM_API_HOST=api.telegram.org
# Optional: force a reachable Telegram API IPv4 if the VPS DNS points to a blocked/unroutable address.
TELEGRAM_API_IP=
TELEGRAM_API_TIMEOUT_MS=15000
# Optional SotoPong-style Cloudflare Worker proxy. Leave empty unless you own a proxy for this bot token.
TELEGRAM_PROXY_URL=
ADMIN_TELEGRAM_IDS=123456789
UNLIMITED_TELEGRAM_IDS=123456789

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
TRANSLATION_MODEL=google/gemini-2.5-flash
TRANSLATION_FALLBACK_MODEL=google/gemini-2.5-pro
TRANSLATION_TEMPERATURE=0.1
TRANSLATION_ENABLE_FALLBACK=true
OPENROUTER_TIMEOUT_MS=180000

# Product limits
TRIAL_CREDITS=3
CREDIT_CHARS=10000
MAX_SUBTITLE_CHARS=250000
MAX_ACTIVE_JOBS_PER_USER=1
TRANSLATION_CHUNK_MAX_CUES=80
TRANSLATION_CHUNK_MAX_CHARS=8000
TRANSLATION_CHUNK_MAX_TOKENS=12000

# Robokassa
ROBOKASSA_MERCHANT_LOGIN=merchant_login
ROBOKASSA_PASSWORD1=password_1
ROBOKASSA_PASSWORD2=password_2
ROBOKASSA_HASH_ALGO=md5
ROBOKASSA_TEST=true
CREDIT_PACKAGES=30:299,100:899,300:2390,1000:6990

# Optional fiscal receipt. Keep disabled until Robokassa fiscalization is configured.
ROBOKASSA_RECEIPT_ENABLED=false
ROBOKASSA_RECEIPT_SNO=usn_income
ROBOKASSA_RECEIPT_TAX=none
